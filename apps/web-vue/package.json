{
  "name": "web-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:hono": "npm run build && wrangler pages dev dist",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:hono": "vitest run functions/**/*.test.ts",
    "typecheck": "vue-tsc -b",
    "seed:tts": "node scripts/seed-tts.mjs",
    "seed:tts:remote": "node scripts/seed-tts.mjs --remote"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.127.1"
  }
}
